# PostgreSQL connection string
# In docker-compose: postgresql+psycopg2://myuser:12345@db:5432/mydata
# Running uvicorn on host: postgresql+psycopg2://myuser:12345@localhost:5432/mydata
DATABASE_URL=postgresql+psycopg2://myuser:12345@db:5432/mydata

# JWT auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# CORS origins (comma-separated, for dev direct URL access)
CORS_ORIGINS=http://localhost:5173
