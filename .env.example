# ForUm environment (read by docker-compose.prod.yml and host-run tooling)
# Copy to .env and fill in the values.

# PostgreSQL connection string.
# - Local dev via docker-compose.prod.yml (bundled db service): use the
#   container name:  postgresql+psycopg2://myuser:12345@db:5432/mydata
# - Managed-db deploy (platform DATABASE_URL): paste the platform URL here.
DATABASE_URL=postgresql+psycopg2://myuser:12345@db:5432/mydata

# JWT auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# CORS origins (comma-separated, for dev direct URL access)
CORS_ORIGINS=http://localhost:5173

# Optional. The compiled client directory inside the image (already defaulted
# to /app/client/dist there); override only if you relocate it.
# STATIC_DIR=/app/client/dist

# Optional. Port uvicorn binds to; platforms that inject $PORT set this
# automatically. Defaults to 8000.
# PORT=8000
